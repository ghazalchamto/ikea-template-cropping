{
  "family_id": "1R10-PRADM",
  "display_name": "1R10-PRADM — Small landscape packaging label with DataMatrix",
  "description": "Small landscape label format. Left-anchored identity zone (product name + article number + article code), followed by IKEA logo, DataMatrix barcode block, address/info block, optional compliance/legal/date/copy zones on the right.",
  "orientation": "landscape",
  "default_x_dimension_mm": 0.5,
  "source_evidence": {
    "page": 3,
    "position_on_page": "top-right label name",
    "snippet": "1R10-PRADM"
  },
  "base_elements": [
    {
      "element_id": "product_name",
      "label": "Product name",
      "semantic_role": "product_identity",
      "type": "text",
      "required": true,
      "repeatable": false,
      "content_type": "variable",
      "example_value": "PRODUCTNAME",
      "allowed_patterns": ["^[A-Z0-9 /\\-]+$"],
      "font": { "family": "IKEA proprietary sans-serif", "weight": "bold", "style": "normal", "case": "upper", "size_mm_approx": 3.0, "variant_ref": "PNAME_SM", "note": "1R10 uses PNAME_SM (~3mm bold upper)" },
      "color": { "text_color": "#000000", "background_color": "transparent" },
      "size_spec": { "width_mm": "variable — fills left_identity zone width", "height_mm_approx": 4 },
      "placement": { "zone": "left_identity", "alignment": "left", "relative_to": "label_top_left", "position_notes": "First (topmost) element in left_identity zone" },
      "orientation": "horizontal",
      "evidence": { "page": 3, "evidence_type": "label_spec_text", "snippet": "PRODUCTNAME (bold uppercase)" }
    },
    {
      "element_id": "article_number",
      "label": "Article number",
      "semantic_role": "product_identity",
      "type": "text",
      "required": true,
      "repeatable": false,
      "content_type": "variable",
      "example_value": "000.000.00",
      "allowed_patterns": ["^\\d{3}\\.\\d{3}\\.\\d{2}$"],
      "font": { "family": "IKEA proprietary sans-serif", "weight": "regular", "style": "normal", "case": "mixed", "size_mm_approx": 2.5, "variant_ref": "ARTNO_SM", "note": "1R10 uses ARTNO_SM — no background" },
      "color": { "text_color": "#000000", "background_color": "transparent", "border": "none" },
      "size_spec": { "width_mm_approx": 18, "height_mm_approx": 3 },
      "placement": { "zone": "left_identity", "alignment": "left", "relative_to": "product_name", "margin_below_mm": 1, "position_notes": "Directly below product_name" },
      "orientation": "horizontal",
      "evidence": { "page": 3, "evidence_type": "label_spec_text", "snippet": "000.000.00" }
    },
    {
      "element_id": "article_code",
      "label": "Article code (short)",
      "semantic_role": "product_identity",
      "type": "text",
      "required": true,
      "repeatable": false,
      "content_type": "variable",
      "example_value": "12345",
      "allowed_patterns": ["^\\d{5}$"],
      "font": { "family": "IKEA proprietary sans-serif", "weight": "regular", "style": "normal", "case": "numeric", "size_mm_approx": 1.8 },
      "color": { "text_color": "#000000", "background_color": "transparent" },
      "size_spec": { "width_mm_approx": 10, "height_mm_approx": 2 },
      "placement": { "zone": "left_identity", "alignment": "left", "relative_to": "article_number", "margin_below_mm": 0.5, "position_notes": "Directly below article_number, smaller font" },
      "orientation": "horizontal",
      "evidence": { "page": 3, "evidence_type": "label_spec_text", "snippet": "12345" }
    },
    {
      "element_id": "ikea_logo",
      "label": "IKEA logo",
      "semantic_role": "brand_identity",
      "type": "image",
      "required": true,
      "repeatable": false,
      "content_type": "static",
      "example_value": "IKEA logo with 'Design and Quality IKEA of Sweden'",
      "logo_variant_ref": "LOGO_LG",
      "color": { "text_color": "#000000", "background_color": "#FFD100", "border": "solid_rectangle" },
      "size_spec": { "width_mm_approx": 20, "height_mm_approx": 15, "variant_ref": "LOGO_LG" },
      "placement": { "zone": "left_identity", "alignment": "left", "relative_to": "article_code", "margin_below_mm": 1, "position_notes": "Below article_code; full LOGO_LG with Design and Quality + IKEA of Sweden" },
      "orientation": "horizontal",
      "evidence": { "page": 3, "evidence_type": "diagram_annotation", "snippet": "IKEA logo — Design and Quality IKEA of Sweden variant" }
    },
    {
      "element_id": "datamatrix_block",
      "label": "DataMatrix barcode block",
      "semantic_role": "barcode_symbol",
      "type": "datamatrix",
      "required": true,
      "repeatable": false,
      "content_type": "variable",
      "example_value": "AI(240)12345678123451 AI(11)210527",
      "allowed_patterns": ["^AI\\(240\\)[0-9A-Z]{14,20}$"],
      "color": { "text_color": "#000000", "background_color": "#FFFFFF", "note": "High contrast required for scanner readability; min contrast ratio 3:1" },
      "size_spec": { "note": "Determined by x-dim — see shared_specs/barcode_specs.json DM_RECT", "x_dim_0_5_typical_mm": "8×24mm (16×48) or 9×25mm (18×50)" },
      "placement": { "zone": "center_barcode", "alignment": "center", "relative_to": "ikea_logo", "position_notes": "Immediately right of left_identity zone; AI lines printed below symbol" },
      "orientation": "horizontal",
      "shared_spec_ref": "DM_RECT",
      "content_rules": {
        "required_ais": ["AI(240)"],
        "optional_ais": ["AI(11)"],
        "ai_240_format": "^AI\\(240\\)[0-9]{14,20}$",
        "ai_11_format": "^AI\\(11\\)\\d{6}$",
        "ai_11_date_format": "YYMMDD"
      },
      "evidence": { "page": 3, "evidence_type": "diagram_annotation", "snippet": "AI(240)12345678123451 AI(11)210527" }
    },
    {
      "element_id": "address_block",
      "label": "Address and copyright block",
      "semantic_role": "address_block",
      "type": "composite_block",
      "required": true,
      "repeatable": false,
      "content_type": "variable",
      "example_value": "IKEA of Sweeden AB\nSE – 34381 Älmhult\n© Inter IKEA Systems\nB.V. 2022  IKEA.com",
      "font": { "family": "IKEA proprietary sans-serif", "weight": "regular", "style": "normal", "case": "mixed", "size_mm_approx": 1.5, "line_count": 4 },
      "color": { "text_color": "#000000", "background_color": "transparent" },
      "size_spec": { "width_mm_approx": 30, "height_mm_approx": 10 },
      "placement": { "zone": "center_address", "alignment": "left", "relative_to": "datamatrix_block", "position_notes": "Immediately right of DataMatrix block; multi-line small text" },
      "orientation": "horizontal",
      "content_structure": {
        "lines": [
          { "line": 1, "content": "Company name", "example": "IKEA of Sweeden AB", "pattern": "^IKEA of Swee?den AB$" },
          { "line": 2, "content": "Postal address", "example": "SE – 34381 Älmhult", "pattern": "^SE\\s[–-]\\s34381 Älmhult$" },
          { "line": 3, "content": "Copyright notice", "example": "© Inter IKEA Systems", "pattern": "^©\\s*Inter IKEA Systems$" },
          { "line": 4, "content": "Year and URL", "example": "B.V. 2022  IKEA.com", "pattern": "^B\\.V\\.\\s*20\\d{2}\\s+IKEA\\.com$" }
        ]
      },
      "evidence": { "page": 3, "evidence_type": "label_spec_text", "snippet": "IKEA of Sweeden AB SE – 34381 Älmhult © Inter IKEA Systems B.V. 2022 IKEA.com" }
    },
    {
      "element_id": "origin_text",
      "label": "Country of origin / assembly text",
      "semantic_role": "origin_text",
      "type": "text",
      "required": true,
      "repeatable": false,
      "content_type": "variable",
      "example_value": "Made in People's Republic of China",
      "allowed_patterns": ["^(Made in|Assembled in USA from Imported Materials|Assembled in) .+$"],
      "font": { "family": "IKEA proprietary sans-serif", "weight": "regular", "style": "normal", "case": "mixed", "size_mm_approx": 1.5 },
      "color": { "text_color": "#000000", "background_color": "transparent" },
      "size_spec": { "width_mm_approx": 30, "height_mm_approx": 2 },
      "placement": { "zone": "center_address", "alignment": "left", "relative_to": "address_block", "margin_below_mm": 0.5, "position_notes": "Below address_block" },
      "orientation": "horizontal",
      "allowed_values": [
        "Made in People's Republic of China",
        "Assembled in USA from Imported Materials",
        "Made in Vietnam",
        "Made in Poland",
        "Made in India"
      ],
      "evidence": { "page": 3, "evidence_type": "label_spec_text", "snippet": "Made in People's Republic of China" }
    }
  ],
  "base_rules": [
    {
      "rule_id": "1R10-PRADM-R000",
      "rule_type": "placement_rule",
      "scope": "1R10-PRADM",
      "condition": "always",
      "target": "all_elements",
      "actions": [{ "action_type": "apply_spec", "description": "Elements must appear in zone order: left_identity → center_barcode → center_address → right zones", "parameter": { "zone_order_ref": "shared_specs/zone_definitions.json#zone_order_left_to_right" } }],
      "severity": "must",
      "normalized_text": "All zones must appear in defined left-to-right order",
      "evidence": { "page": 3, "evidence_type": "diagram_annotation", "snippet": "Left-to-right label layout observed across all 1R10 variants" }
    },
    {
      "rule_id": "1R10-PRADM-R001",
      "rule_type": "resize_rule",
      "scope": "1R10-PRADM",
      "condition": "DATE field is available/present on the label",
      "target": "date_stamp_section",
      "actions": [
        { "action_type": "grow", "description": "Grow datestamp section from 7mm to 22.5mm", "parameter": { "from_mm": 7, "to_mm": 22.5 } }
      ],
      "severity": "must",
      "normalized_text": "IF date_present THEN grow_date_section(7mm → 22.5mm)",
      "evidence": { "page": 3, "evidence_type": "inline_note", "snippet": "When DATE is available: 1. Grow datestamp section from 7mm to 22.5mm." }
    },
    {
      "rule_id": "1R10-PRADM-R002",
      "rule_type": "orientation_rule",
      "scope": "1R10-PRADM",
      "condition": "DATE field is available/present on the label",
      "target": "date_stamp",
      "actions": [
        { "action_type": "rotate", "description": "Rotate date stamp text to horizontal orientation", "parameter": { "from": "vertical_cw90", "to": "horizontal" } }
      ],
      "severity": "must",
      "normalized_text": "IF date_present THEN rotate_date_to_horizontal",
      "evidence": { "page": 3, "evidence_type": "inline_note", "snippet": "When DATE is available: 2. Rotate to text horizontally." }
    },
    {
      "rule_id": "1R10-PRADM-R003",
      "rule_type": "alignment_rule",
      "scope": "1R10-PRADM",
      "condition": "DATE field is available/present on the label",
      "target": "yyww_stamp",
      "actions": [
        { "action_type": "reposition", "description": "YYWW value must appear directly after DATE label with no gap", "parameter": { "adjacent_to": "date_label", "side": "right" } }
      ],
      "severity": "must",
      "normalized_text": "IF date_present THEN position_YYWW_immediately_after_DATE_label",
      "evidence": { "page": 3, "evidence_type": "inline_note", "snippet": "When DATE is available: 3. Adjust the position so that YYWW always appears directly after DATE." }
    },
    {
      "rule_id": "1R10-PRADM-R004",
      "rule_type": "symbol_logic_rule",
      "scope": "1R10-PRADM",
      "condition": "always",
      "target": "product_name",
      "actions": [{ "action_type": "apply_spec", "description": "product_name visual size must exceed article_number visual size", "parameter": { "comparison": "font_size_product_name > font_size_article_number" } }],
      "severity": "must",
      "normalized_text": "product_name font MUST be larger than article_number font",
      "evidence": { "page": 2, "evidence_type": "diagram_annotation", "snippet": "Size hierarchy visible in product name vs article number variants on page 2" }
    },
    {
      "rule_id": "1R10-PRADM-R005",
      "rule_type": "symbol_logic_rule",
      "scope": "1R10-PRADM",
      "condition": "always",
      "target": "article_number",
      "actions": [{ "action_type": "apply_spec", "description": "article_number visual size must exceed article_code visual size", "parameter": { "comparison": "font_size_article_number > font_size_article_code" } }],
      "severity": "must",
      "normalized_text": "article_number font MUST be larger than article_code font",
      "evidence": { "page": 2, "evidence_type": "diagram_annotation", "snippet": "Size hierarchy visible across identity element variants on page 2" }
    },
    {
      "rule_id": "1R10-PRADM-R006",
      "rule_type": "conditional_layout_transform",
      "scope": "1R10-PRADM",
      "condition": "origin_text contains country = USA/United States",
      "target": "address_block",
      "actions": [{ "action_type": "apply_spec", "description": "When origin is USA, address block must not indicate a non-US manufacturing location", "parameter": { "consistency_check": "origin_country must not contradict address_block_region" } }],
      "severity": "must",
      "normalized_text": "IF origin_text=USA THEN address_block must NOT indicate a conflicting country",
      "evidence": { "page": 4, "evidence_type": "label_spec_text", "snippet": "Assembled in USA from Imported Materials — implies US final assembly" }
    },
    {
      "rule_id": "1R10-PRADM-R007",
      "rule_type": "presence_rule",
      "scope": "1R10-PRADM",
      "condition": "always",
      "target": "datamatrix_block",
      "actions": [{ "action_type": "apply_spec", "description": "DataMatrix must contain at minimum AI(240); AI(11) is strongly recommended", "parameter": { "required_ais": ["AI(240)"], "recommended_ais": ["AI(11)"] } }],
      "severity": "must",
      "normalized_text": "datamatrix_block MUST contain AI(240); AI(11) SHOULD be present",
      "evidence": { "page": 3, "evidence_type": "diagram_annotation", "snippet": "AI(240)12345678123451 AI(11)210527" }
    },
    {
      "rule_id": "1R10-PRADM-R008",
      "rule_type": "application_method_rule",
      "scope": "1R10-PRADM",
      "condition": "always",
      "target": "article_number",
      "actions": [{ "action_type": "apply_spec", "description": "Article number format must strictly match NNN.NNN.NN (3+3+2 digit groups separated by dots)", "parameter": { "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$" } }],
      "severity": "must",
      "normalized_text": "article_number MUST match pattern \\d{3}.\\d{3}.\\d{2}",
      "evidence": { "page": 3, "evidence_type": "label_spec_text", "snippet": "000.000.00 format shown on all templates" }
    }
  ],
  "variant_ids": [
    "1R10-PRADM_v1",
    "1R10-PRADM_v2",
    "1R10-PRADM_v3",
