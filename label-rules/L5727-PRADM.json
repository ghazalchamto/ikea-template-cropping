{
  "label_type_id": "L5727-PRADM",
  "label_type_name": "Long Narrow 57x27mm – Product Reference A (Hinge Hole, Kitchen)",
  "source_pages": [
    32
  ],
  "description": "Special label for kitchen cabinet hinge holes. 57x27mm. DM 16x48 at 0.4mm. Address printed vertically.",
  "physical_dimensions_mm": {
    "width": 57,
    "height": 27
  },
  "shape": "long_narrow",
  "copy_count_default": 1,
  "datamatrix": {
    "symbol_size": "16x48",
    "x_dimension_options_mm": [
      0.4
    ],
    "specs": {
      "symbol_rows": 16,
      "symbol_cols": 48,
      "x_dim_mm": 0.4,
      "physical_mm": "19.2x6.4",
      "physical_incl_qz_mm": "20x7.2"
    },
    "gs1_ais_present": [
      "AI_240",
      "AI_11"
    ],
    "encoding": "GS1"
  },
  "itf_barcode": null,
  "required_fields": [
    "product_name",
    "article_number",
    "internal_item_number",
    "origin_text",
    "plant_identifier",
    "human_readable_date",
    "supplier_name",
    "supplier_address",
    "copyright_notice"
  ],
  "optional_fields": [
    "ikea_com_url",
    "copy_count_inline"
  ],
  "field_patterns": {
    "product_name": {
      "type": "string",
      "pattern": "^[A-ZÅÄÖ][A-ZÅÄÖ0-9 /\\-]{0,39}$",
      "notes": "ALL-CAPS, max 40 chars"
    },
    "article_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "example": "803.812.94"
    },
    "internal_item_number": {
      "type": "string",
      "pattern": "^\\d{5}$",
      "example": "12345",
      "notes": "5-digit number printed near barcode"
    },
    "origin_text": {
      "type": "string",
      "pattern": "^(Made in|Assembled in)\\s.+$",
      "example": "Made in People's Republic of China"
    },
    "plant_identifier": {
      "type": "string",
      "pattern": "^PI-\\d{6,9}-\\d{1,3}$",
      "example": "PI-123456789-123"
    },
    "human_readable_date": {
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{2}$",
      "example": "26-04-02",
      "notes": "YY-MM-DD printed next to (YY-MM-DD) label"
    },
    "supplier_name": {
      "type": "string",
      "allowed_values": [
        "IKEA of Sweden AB"
      ]
    },
    "supplier_address": {
      "type": "string",
      "pattern": "^SE\\s[–-]\\s34381\\s[ÄA]lmhult$",
      "allowed_values": [
        "SE – 34381 Älmhult"
      ]
    },
    "copyright_notice": {
      "type": "string",
      "pattern": "^©\\s+Inter\\s+IKEA\\s+Systems\\s+B\\.V\\.\\s+\\d{4}$",
      "example": "© Inter IKEA Systems B.V. 2022"
    }
  },
  "validation_rules": [
    {
      "rule_id": "L5727-001",
      "field": "datamatrix",
      "check": "ai_field_present",
      "ai": "11",
      "severity": "error"
    },
    {
      "rule_id": "L5727-002",
      "field": "article_number",
      "check": "regex_match",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "severity": "error"
    }
  ],
  "notes": "Designed for kitchen furniture hinge-hole labels. Address text is rotated 90°."
}