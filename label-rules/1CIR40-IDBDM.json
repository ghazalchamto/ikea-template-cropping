{
  "label_type_id": "1CIR40-IDBDM",
  "label_type_name": "Circular 40mm – Identity B with DataMatrix",
  "source_pages": [
    46
  ],
  "description": "Circular label 40mm with compliance symbols, ITF barcode, and legal symbols. Addresses printed radially.",
  "physical_dimensions_mm": {
    "diameter": 40
  },
  "shape": "circular",
  "copy_count_default": 1,
  "datamatrix": {
    "symbol_size": "26x26",
    "x_dimension_options_mm": [
      0.4
    ],
    "specs": {
      "symbol_rows": 26,
      "symbol_cols": 26,
      "x_dim_mm": 0.4,
      "physical_mm": "10.4x10.4",
      "physical_incl_qz_mm": "11.2x11.2"
    },
    "gs1_ais_present": [
      "AI_240",
      "AI_13"
    ],
    "encoding": "GS1"
  },
  "itf_barcode": {
    "magnification_pct": 25,
    "x_dim_mm": 0.254,
    "ratio": 2.5,
    "module_width": 2,
    "barcode_height_mm": 5,
    "barcode_length_mm": 30.1,
    "total_length_incl_qz_mm": 35.1,
    "quiet_zone": "10 x-dim each side (2x2.5mm)"
  },
  "required_fields": [
    "origin_text",
    "supplier_name",
    "supplier_address",
    "ikea_com_url",
    "weight_compact",
    "dimensions_metric",
    "dimensions_imperial",
    "copy_count_inline",
    "legal_symbols"
  ],
  "optional_fields": [
    "compliance_marks",
    "copyright_notice",
    "article_number"
  ],
  "field_patterns": {
    "origin_text": {
      "type": "string",
      "pattern": "^(Made in|Assembled in)\\s.+$",
      "example": "Made in People's Republic of China"
    },
    "supplier_name": {
      "type": "string",
      "allowed_values": [
        "IKEA of Sweden AB"
      ]
    },
    "supplier_address": {
      "type": "string",
      "pattern": "^SE\\s[–-]\\s34381\\s[ÄA]lmhult$",
      "allowed_values": [
        "SE – 34381 Älmhult"
      ]
    },
    "weight_compact": {
      "type": "string",
      "pattern": "^\\d+\\s?kg\\n\\(\\d+\\s?lbs\\)$",
      "example": "00 kg\n(00 lbs)",
      "notes": "Compact two-line format on small labels"
    },
    "dimensions_metric": {
      "type": "string",
      "pattern": "^\\d{1,4}x\\d{1,4}x?\\d{0,4}\\s?cm$",
      "example": "000x000x000 cm"
    },
    "dimensions_imperial": {
      "type": "string",
      "pattern": "^\\(\\d+\\s\\d+/\\d+x.*\"\\)$",
      "example": "(00 0/0x00 0/0x 00 0/0\")"
    },
    "copy_count_inline": {
      "type": "string",
      "pattern": "^1\\(\\d+\\)$",
      "example": "1(3)",
      "notes": "Copy n of total, printed on label face"
    }
  },
  "validation_rules": [
    {
      "rule_id": "CIR40B-001",
      "field": "legal_symbols",
      "check": "present",
      "severity": "error"
    },
    {
      "rule_id": "CIR40B-002",
      "field": "datamatrix",
      "check": "ai_field_present",
      "ai": "13",
      "severity": "error"
    }
  ],
  "notes": "Address and origin text are radially printed along the circumference."
}