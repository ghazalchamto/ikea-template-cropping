  "field_patterns": {
    "supplier_name": {
      "type": "string",
      "allowed_values": [
        "IKEA of Sweden AB"
      ]
    },
    "supplier_address": {
      "type": "string",
      "pattern": "^SE\\s[–-]\\s34381\\s[ÄA]lmhult$",
      "allowed_values": [
        "SE – 34381 Älmhult"
      ]
    },
    "copyright_notice": {
      "type": "string",
      "pattern": "^©\\s+Inter\\s+IKEA\\s+Systems\\s+B\\.V\\.\\s+\\d{4}$",
      "example": "© Inter IKEA Systems B.V. 2022"
    },
    "gb_import_text": {
      "type": "string",
      "allowed_values": [
        "Imported to GB by: IKEA Ltd., 100 Avebury Blvd, Milton Keynes, UK, MK9 1FH"
      ]
    }
  },
  "validation_rules": [
    {
      "rule_id": "CIR40F-001",
      "field": "gb_import_text",
      "check": "exact_match",
      "value": "Imported to GB by: IKEA Ltd., 100 Avebury Blvd, Milton Keynes, UK, MK9 1FH",
      "severity": "error"
    },
    {
      "rule_id": "CIR40F-002",
      "field": "plant_vs_pot",
      "check": "conditional",
      "notes": "scientific_name required for plant, absent for pot",
      "severity": "warning"
