{
  "label_type_id": "1R25-IDCDM_IDCSDM",
  "label_type_name": "Rectangular 25mm – Identity C (Compact) / Identity C Short",
  "source_pages": [
    13
  ],
  "description": "Compact 25mm label with micro ITF (25% magnification). IDC = standard compact. IDCS = short variant with less address info.",
  "physical_dimensions_mm": {
    "width": "~90",
    "height": 25
  },
  "shape": "rectangular",
  "copy_count_default": 1,
  "datamatrix": {
    "symbol_size": "16x48 or 26x26",
    "x_dimension_options_mm": [
      0.4
    ],
    "specs": {
      "symbol_rows": 16,
      "symbol_cols": 48,
      "x_dim_mm": 0.4,
      "physical_mm": "19.2x6.4",
      "physical_incl_qz_mm": "20x7.2"
    },
    "gs1_ais_present": [
      "AI_240",
      "AI_13"
    ],
    "encoding": "GS1"
  },
  "itf_barcode": {
    "magnification_pct": 25,
    "x_dim_mm": 0.254,
    "ratio": 2.5,
    "module_width": 2,
    "barcode_height_mm": 5,
    "barcode_length_mm": 30.1,
    "total_length_incl_qz_mm": 35.1,
    "quiet_zone": "10 x-dim each side (2x2.5mm)"
  },
  "required_fields": [
    "ikea_logo",
    "product_name",
    "article_number",
    "internal_item_number",
    "origin_text",
    "plant_identifier",
    "human_readable_date",
    "copy_count_inline"
  ],
  "optional_fields": [
    "supplier_name",
    "supplier_address",
    "copyright_notice",
    "ikea_com_url",
    "custom_identifier",
    "dimensions_metric"
  ],
  "idcs_omits": [
    "supplier_name",
    "supplier_address",
    "copyright_notice"
  ],
  "field_patterns": {
    "product_name": {
      "type": "string",
      "pattern": "^[A-ZÅÄÖ][A-ZÅÄÖ0-9 /\\-]{0,39}$",
      "notes": "ALL-CAPS, max 40 chars"
    },
    "article_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "example": "803.812.94"
    },
    "internal_item_number": {
      "type": "string",
      "pattern": "^\\d{5}$",
      "example": "12345",
      "notes": "5-digit number printed near barcode"
    },
    "copy_count_inline": {
      "type": "string",
      "pattern": "^1\\(\\d+\\)$",
      "example": "1(3)",
      "notes": "Copy n of total, printed on label face"
    },
    "plant_identifier": {
      "type": "string",
      "pattern": "^PI-\\d{6,9}-\\d{1,3}$",
      "example": "PI-123456789-123"
    },
    "origin_text": {
      "type": "string",
      "pattern": "^(Made in|Assembled in)\\s.+$",
      "example": "Made in People's Republic of China"
    }
  },
  "validation_rules": [
    {
      "rule_id": "1R25-001",
      "field": "itf_barcode",
      "check": "magnification",
      "value": 25,
      "severity": "error"
    },
    {
      "rule_id": "1R25-002",
      "field": "itf_barcode",
      "check": "height_mm",
      "value": 5,
      "severity": "error"
    },
    {
      "rule_id": "1R25-003",
      "field": "article_number",
      "check": "regex_match",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "severity": "error"
    }
  ],
  "notes": "IDCSDM is a shortened version — supplier address may be omitted."
}