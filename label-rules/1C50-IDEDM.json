{
  "label_type_id": "1C50-IDEDM",
  "label_type_name": "Card 50mm – Identity E (Textile/Care Label)",
  "source_pages": [
    25
  ],
  "description": "Textile care label with ISO 3758 wash symbols, legal symbols, CA registration code and NIF. No ITF barcode.",
  "physical_dimensions_mm": {
    "width": 50,
    "height": "variable"
  },
  "shape": "card_portrait",
  "copy_count_default": 1,
  "datamatrix": {
    "symbol_size": "26x26",
    "x_dimension_options_mm": [
      0.4
    ],
    "specs": {
      "symbol_rows": 26,
      "symbol_cols": 26,
      "x_dim_mm": 0.4,
      "physical_mm": "10.4x10.4",
      "physical_incl_qz_mm": "11.2x11.2"
    },
    "gs1_ais_present": [
      "AI_240",
      "AI_13"
    ],
    "encoding": "GS1"
  },
  "itf_barcode": null,
  "required_fields": [
    "product_name",
    "article_number",
    "internal_item_number",
    "origin_text",
    "supplier_name",
    "supplier_address",
    "copyright_notice",
    "plant_identifier",
    "human_readable_date",
    "dimensions_metric",
    "dimensions_imperial",
    "weight_compact",
    "wash_symbols",
    "legal_symbols",
    "ca_code"
  ],
  "optional_fields": [
    "nif_code",
    "ikea_com_url",
    "compliance_marks"
  ],
  "field_patterns": {
    "product_name": {
      "type": "string",
      "pattern": "^[A-ZÅÄÖ][A-ZÅÄÖ0-9 /\\-]{0,39}$",
      "notes": "ALL-CAPS, max 40 chars"
    },
    "article_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "example": "803.812.94"
    },
    "internal_item_number": {
      "type": "string",
      "pattern": "^\\d{5}$",
      "example": "12345",
      "notes": "5-digit number printed near barcode"
    },
    "origin_text": {
      "type": "string",
      "pattern": "^(Made in|Assembled in)\\s.+$",
      "example": "Made in People's Republic of China"
    },
    "supplier_name": {
      "type": "string",
      "allowed_values": [
        "IKEA of Sweden AB"
      ]
    },
    "supplier_address": {
      "type": "string",
      "pattern": "^SE\\s[–-]\\s34381\\s[ÄA]lmhult$",
      "allowed_values": [
        "SE – 34381 Älmhult"
      ]
    },
    "copyright_notice": {
      "type": "string",
      "pattern": "^©\\s+Inter\\s+IKEA\\s+Systems\\s+B\\.V\\.\\s+\\d{4}$",
      "example": "© Inter IKEA Systems B.V. 2022"
    },
    "plant_identifier": {
      "type": "string",
      "pattern": "^PI-\\d{6,9}-\\d{1,3}$",
      "example": "PI-123456789-123"
    },
    "human_readable_date": {
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{2}$",
      "example": "26-04-02",
      "notes": "YY-MM-DD printed next to (YY-MM-DD) label"
    },
    "dimensions_metric": {
      "type": "string",
      "pattern": "^\\d{1,4}x\\d{1,4}x?\\d{0,4}\\s?cm$",
      "example": "000x000x000 cm"
    },
    "weight_compact": {
      "type": "string",
      "pattern": "^\\d+\\s?kg\\n\\(\\d+\\s?lbs\\)$",
      "example": "00 kg\n(00 lbs)",
      "notes": "Compact two-line format on small labels"
    },
    "ca_code": {
      "type": "string",
      "pattern": "^CA\\s?0?5404$",
      "example": "CA 05404",
      "notes": "Canadian compliance code"
    },
    "nif_code": {
      "type": "string",
      "pattern": "^NIF\\sN[0-9A-Z]+$",
      "example": "NIF N03918B57J",
      "notes": "Spanish NIF code"
    }
  },
  "wash_symbol_rules": {
    "standard": "ISO 3758",
    "placement": "Bottom section of label",
    "min_count": 1
  },
  "validation_rules": [
    {
      "rule_id": "1C50E-001",
      "field": "wash_symbols",
      "check": "present",
      "severity": "error"
    },
    {
      "rule_id": "1C50E-002",
      "field": "ca_code",
      "check": "regex_match",
      "pattern": "^CA\\s?0?5404$",
      "severity": "error"
    },
    {
      "rule_id": "1C50E-003",
      "field": "article_number",
      "check": "regex_match",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "severity": "error"
    },
    {
      "rule_id": "1C50E-004",
      "field": "datamatrix",
      "check": "ai_field_present",
      "ai": "13",
      "severity": "error"
    }
  ]
}