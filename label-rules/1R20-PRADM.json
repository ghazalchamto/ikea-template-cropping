{
  "label_type_id": "1R20-PRADM",
  "label_type_name": "Rectangular 20mm – Product Reference with DataMatrix",
  "source_pages": [
    4,
    5
  ],
  "description": "Standard product label with DataMatrix. Two official x-dimension variants (0.4 and 0.75). Uses rectangular 26x26 DM at 0.4 and rectangular 16x48 DM at 0.75.",
  "physical_dimensions_mm": {
    "width": "~120 (varies by content)",
    "height": 20
  },
  "shape": "rectangular",
  "copy_count_default": 1,
  "datamatrix_variants": {
    "0.4_x_dim": {
      "symbol_size": "26x26 (square)",
      "specs": {
        "symbol_rows": 26,
        "symbol_cols": 26,
        "x_dim_mm": 0.4,
        "physical_mm": "10.4x10.4",
        "physical_incl_qz_mm": "11.2x11.2"
      },
      "gs1_ais_present": [
        "AI_240",
        "AI_11"
      ],
      "encoding": "GS1"
    },
    "0.75_x_dim": {
      "symbol_size": "16x48 (rectangular)",
      "specs": {
        "symbol_rows": 16,
        "symbol_cols": 48,
        "x_dim_mm": 0.75,
        "physical_mm": "36x12",
        "physical_incl_qz_mm": "37.5x13.5"
      },
      "gs1_ais_present": [
        "AI_240",
        "AI_11"
      ],
      "encoding": "GS1"
    }
  },
  "itf_barcode": null,
  "ean13_barcode": null,
  "required_fields": [
    "ikea_logo",
    "product_name",
    "article_number",
    "internal_item_number",
    "origin_text",
    "supplier_name",
    "supplier_address",
    "copyright_notice",
    "plant_identifier",
    "human_readable_date",
    "custom_identifier"
  ],
  "optional_fields": [
    "ikea_com_url",
    "compliance_marks",
    "legal_symbols",
    "tsca_text",
    "patents_url",
    "date_stamp_yyww"
  ],
  "field_patterns": {
    "product_name": {
      "type": "string",
      "pattern": "^[A-ZÅÄÖ][A-ZÅÄÖ0-9 /\\-]{0,39}$",
      "notes": "ALL-CAPS, max 40 chars"
    },
    "article_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "example": "803.812.94"
    },
    "internal_item_number": {
      "type": "string",
      "pattern": "^\\d{5}$",
      "example": "12345",
      "notes": "5-digit number printed near barcode"
    },
    "origin_text": {
      "type": "string",
      "pattern": "^(Made in|Assembled in)\\s.+$",
      "example": "Made in People's Republic of China"
    },
    "plant_identifier": {
      "type": "string",
      "pattern": "^PI-\\d{6,9}-\\d{1,3}$",
      "example": "PI-123456789-123"
    },
    "supplier_name": {
      "type": "string",
      "allowed_values": [
        "IKEA of Sweden AB"
      ]
    },
    "supplier_address": {
      "type": "string",
      "pattern": "^SE\\s[–-]\\s34381\\s[ÄA]lmhult$",
      "allowed_values": [
        "SE – 34381 Älmhult"
      ]
    },
    "copyright_notice": {
      "type": "string",
      "pattern": "^©\\s+Inter\\s+IKEA\\s+Systems\\s+B\\.V\\.\\s+\\d{4}$",
      "example": "© Inter IKEA Systems B.V. 2022"
    },
    "custom_identifier": {
      "type": "string",
      "pattern": "^[A-Z]{4}-\\d{4}-\\d{3,4}$",
      "example": "ABCD-YYWW-1234",
      "notes": "ALPHA-YYWW-NUM; date section changes weekly"
    },
    "human_readable_date": {
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{2}$",
      "example": "26-04-02",
      "notes": "YY-MM-DD printed next to (YY-MM-DD) label"
    }
  },
  "layout_zones": {
    "left": "IKEA logo + product name + article number",
    "center_dm": "DataMatrix symbol + AI field text",
    "right_address": "Address block (IKEA of Sweden AB, SE – 34381 Älmhult, copyright)",
    "right_date": "Custom ID / date section (ABCD-YYWW-1234)"
  },
  "validation_rules": [
    {
      "rule_id": "1R20-001",
      "field": "datamatrix",
      "check": "ai_field_present",
      "ai": "240",
      "severity": "error"
    },
    {
      "rule_id": "1R20-002",
      "field": "datamatrix",
      "check": "ai_field_present",
      "ai": "11",
      "severity": "error"
    },
    {
      "rule_id": "1R20-003",
      "field": "custom_identifier",
      "check": "regex_match",
      "pattern": "^[A-Z]{4}-\\d{4}-\\d{3,4}$",
      "severity": "error"
    },
    {
      "rule_id": "1R20-004",
      "field": "article_number",
      "check": "regex_match",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "severity": "error"
    },
    {
      "rule_id": "1R20-005",
      "field": "datamatrix_x_dim",
      "check": "one_of",
      "values": [
        0.4,
        0.75
      ],
      "severity": "error"
    }
  ],
  "date_section_rules": {
    "normal_mode": "ABCD-YYWW-1234 on right strip",
    "date_label_mode": "When DATE: — section grows to 22.5mm, rotated horizontal"
  },
  "tsca_variant": {
    "description": "TSCA-compliant wood products add TSCA/ULEF text and patents URL",
    "additional_fields": [
      "tsca_text",
      "patents_url",
      "legal_symbols"
    ]
  }
}