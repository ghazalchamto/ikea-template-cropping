{
  "label_type_id": "1R35-IDGDM",
  "label_type_name": "Rectangular 35mm – Identity G (Purchase Order variant)",
  "source_pages": [
    17,
    49
  ],
  "description": "PO (Purchase Order) label variant of 1R35. Used for retail-ready finished goods. Same layout as IDADM/IDBDM but PO-specific fields.",
  "physical_dimensions_mm": {
    "width": 80,
    "height": 35
  },
  "shape": "rectangular",
  "copy_count_default": 1,
  "datamatrix_variants": {
    "0.75_x_dim": {
      "symbol_size": "16x48",
      "specs": {
        "symbol_rows": 16,
        "symbol_cols": 48,
        "x_dim_mm": 0.75,
        "physical_mm": "36x12",
        "physical_incl_qz_mm": "37.5x13.5"
      },
      "gs1_ais_present": [
        "AI_240",
        "AI_13"
      ],
      "encoding": "GS1"
    }
  },
  "itf_barcode": {
    "magnification_pct": 30,
    "x_dim_mm": 0.305,
    "ratio": 2.5,
    "module_width": 2,
    "barcode_height_mm": 10,
    "barcode_length_mm": 36.7,
    "total_length_incl_qz_mm": 42.8,
    "quiet_zone": "10 x-dim each side (2x3.1mm)"
  },
  "required_fields": [
    "ikea_logo",
    "product_name",
    "article_number",
    "internal_item_number",
    "origin_text",
    "plant_identifier",
    "human_readable_date",
    "custom_identifier",
    "copy_count_inline"
  ],
  "optional_fields": [
    "supplier_name",
    "supplier_address",
    "copyright_notice",
    "ikea_com_url",
    "dimensions_metric",
    "dimensions_imperial",
    "weight_compact"
  ],
  "field_patterns": {
    "product_name": {
      "type": "string",
      "pattern": "^[A-ZÅÄÖ][A-ZÅÄÖ0-9 /\\-]{0,39}$",
      "notes": "ALL-CAPS, max 40 chars"
    },
    "article_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "example": "803.812.94"
    },
    "internal_item_number": {
      "type": "string",
      "pattern": "^\\d{5}$",
      "example": "12345",
      "notes": "5-digit number printed near barcode"
    },
    "origin_text": {
      "type": "string",
      "pattern": "^(Made in|Assembled in)\\s.+$",
      "example": "Made in People's Republic of China"
    },
    "plant_identifier": {
      "type": "string",
      "pattern": "^PI-\\d{6,9}-\\d{1,3}$",
      "example": "PI-123456789-123"
    },
    "custom_identifier": {
      "type": "string",
      "pattern": "^[A-Z]{4}-\\d{4}-\\d{3,4}$",
      "example": "ABCD-YYWW-1234",
      "notes": "ALPHA-YYWW-NUM; date section changes weekly"
    },
    "human_readable_date": {
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{2}$",
      "example": "26-04-02",
      "notes": "YY-MM-DD printed next to (YY-MM-DD) label"
    },
    "copy_count_inline": {
      "type": "string",
      "pattern": "^1\\(\\d+\\)$",
      "example": "1(3)",
      "notes": "Copy n of total, printed on label face"
    }
  },
  "validation_rules": [
    {
      "rule_id": "1R35G-001",
      "field": "article_number",
      "check": "regex_match",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "severity": "error"
    },
    {
      "rule_id": "1R35G-002",
      "field": "datamatrix",
      "check": "ai_field_present",
      "ai": "13",
      "severity": "error"
    },
    {
      "rule_id": "1R35G-003",
      "field": "custom_identifier",
      "check": "regex_match",
      "pattern": "^[A-Z]{4}-\\d{4}-\\d{3,4}$",
      "severity": "error"
    }
  ],
  "notes": "PO variant. AI(13) used instead of AI(11). Physical size: 80x35mm."
}