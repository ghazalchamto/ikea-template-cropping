{
  "label_type_id": "1R7-IDBDM",
  "label_type_name": "Rectangular 7mm – Identity B (with compliance)",
  "source_pages": [
    38
  ],
  "description": "Small label with compliance symbols. DM 16x48 at 0.3mm. Has legal symbols zone.",
  "physical_dimensions_mm": {
    "width": "~60",
    "height": 7
  },
  "shape": "rectangular",
  "copy_count_default": 1,
  "datamatrix": {
    "symbol_size": "16x48",
    "x_dimension_options_mm": [
      0.3
    ],
    "specs": {
      "symbol_rows": 16,
      "symbol_cols": 48,
      "x_dim_mm": 0.3,
      "physical_mm": "14.4x4.8",
      "physical_incl_qz_mm": "15x5.4"
    },
    "gs1_ais_present": [
      "AI_240",
      "AI_13"
    ],
    "encoding": "GS1"
  },
  "itf_barcode": {
    "magnification_pct": 25,
    "x_dim_mm": 0.254,
    "ratio": 2.5,
    "module_width": 2,
    "barcode_height_mm": 5,
    "barcode_length_mm": 30.1,
    "total_length_incl_qz_mm": 35.1,
    "quiet_zone": "10 x-dim each side (2x2.5mm)"
  },
  "required_fields": [
    "product_name",
    "article_number",
    "internal_item_number",
    "origin_text",
    "plant_identifier",
    "human_readable_date",
    "copy_count_inline",
    "weight_compact",
    "dimensions_metric",
    "dimensions_imperial"
  ],
  "optional_fields": [
    "supplier_name",
    "supplier_address",
    "copyright_notice",
    "legal_symbols",
    "date_stamp_yyww"
  ],
  "field_patterns": {
    "product_name": {
      "type": "string",
      "pattern": "^[A-ZÅÄÖ][A-ZÅÄÖ0-9 /\\-]{0,39}$",
      "notes": "ALL-CAPS, max 40 chars"
    },
    "article_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "example": "803.812.94"
    },
    "internal_item_number": {
      "type": "string",
      "pattern": "^\\d{5}$",
      "example": "12345",
      "notes": "5-digit number printed near barcode"
    },
    "origin_text": {
      "type": "string",
      "pattern": "^(Made in|Assembled in)\\s.+$",
      "example": "Made in People's Republic of China"
    },
    "plant_identifier": {
      "type": "string",
      "pattern": "^PI-\\d{6,9}-\\d{1,3}$",
      "example": "PI-123456789-123"
    },
    "human_readable_date": {
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{2}$",
      "example": "26-04-02",
      "notes": "YY-MM-DD printed next to (YY-MM-DD) label"
    },
    "weight_compact": {
      "type": "string",
      "pattern": "^\\d+\\s?kg\\n\\(\\d+\\s?lbs\\)$",
      "example": "00 kg\n(00 lbs)",
      "notes": "Compact two-line format on small labels"
    },
    "dimensions_metric": {
      "type": "string",
      "pattern": "^\\d{1,4}x\\d{1,4}x?\\d{0,4}\\s?cm$",
      "example": "000x000x000 cm"
    },
    "dimensions_imperial": {
      "type": "string",
      "pattern": "^\\(\\d+\\s\\d+/\\d+x.*\"\\)$",
      "example": "(00 0/0x00 0/0x 00 0/0\")"
    },
    "copy_count_inline": {
      "type": "string",
      "pattern": "^1\\(\\d+\\)$",
      "example": "1(3)",
      "notes": "Copy n of total, printed on label face"
    }
  },
  "validation_rules": [
    {
      "rule_id": "1R7B-001",
      "field": "datamatrix_x_dim",
      "check": "exact",
      "value": 0.3,
      "severity": "error"
    },
    {
      "rule_id": "1R7B-002",
      "field": "article_number",
      "check": "regex_match",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "severity": "error"
    }
  ]
}