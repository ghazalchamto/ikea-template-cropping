    "gs1_ai_fields": {
      "AI_240": {
        "code": "240",
        "name": "Additional Product ID",
        "format": "\\d{1,30}",
        "notes": "Item product code (always 14 digits for IKEA labels)"
      },
      "AI_11": {
        "code": "11",
        "name": "Production Date",
        "format": "YYMMDD",
        "notes": "Date of packaging/assembly"
      },
      "AI_13": {
        "code": "13",
        "name": "Packaging Date",
        "format": "YYMMDD",
        "notes": "Date of production/manufacture"
      },
      "AI_10": {
        "code": "10",
        "name": "Batch / Lot Number",
        "format": "alphanumeric",
        "notes": "Optional — not always present"
      }
    },
    "field_patterns": {
      "product_name": {
        "type": "string",
        "pattern": "^[A-ZÅÄÖ][A-ZÅÄÖ0-9 /\\-]{0,39}$",
        "notes": "ALL-CAPS, max 40 chars"
      },
      "article_number": {
        "type": "string",
        "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
        "example": "803.812.94"
      },
      "internal_item_number": {
        "type": "string",
        "pattern": "^\\d{5}$",
        "example": "12345",
        "notes": "5-digit number printed near barcode"
      },
      "custom_identifier": {
        "type": "string",
        "pattern": "^[A-Z]{4}-\\d{4}-\\d{3,4}$",
        "example": "ABCD-YYWW-1234",
        "notes": "ALPHA-YYWW-NUM; date section changes weekly"
      },
      "human_readable_date": {
        "type": "string",
        "pattern": "^\\d{2}-\\d{2}-\\d{2}$",
        "example": "26-04-02",
        "notes": "YY-MM-DD printed next to (YY-MM-DD) label"
      },
      "plant_identifier": {
        "type": "string",
        "pattern": "^PI-\\d{6,9}-\\d{1,3}$",
        "example": "PI-123456789-123"
      },
      "supplier_name": {
        "type": "string",
        "allowed_values": [
          "IKEA of Sweden AB"
        ]
      },
      "supplier_address": {
        "type": "string",
        "pattern": "^SE\\s[–-]\\s34381\\s[ÄA]lmhult$",
        "allowed_values": [
          "SE – 34381 Älmhult"
        ]
      },
      "copyright_notice": {
        "type": "string",
        "pattern": "^©\\s+Inter\\s+IKEA\\s+Systems\\s+B\\.V\\.\\s+\\d{4}$",
        "example": "© Inter IKEA Systems B.V. 2022"
      },
      "ikea_logo": {
        "type": "boolean",
        "notes": "IKEA wordmark must be present"
      },
      "ikea_com_url": {
        "type": "boolean",
        "notes": "IKEA.com printed on some variants"
      },
      "origin_text": {
        "type": "string",
        "pattern": "^(Made in|Assembled in)\\s.+$",
        "example": "Made in People's Republic of China"
      },
      "gross_weight": {
        "type": "string",
        "pattern": "^Gross\\s\\d+\\s?kg\\s+\\(\\d+\\s?lbs\\)$",
        "example": "Gross 12 kg (26 lbs)"
      },
      "net_weight": {
        "type": "string",
        "pattern": "^Net\\s\\d+\\s?kg\\s+\\(\\d+\\s?lbs\\)$",
        "example": "Net 10 kg (22 lbs)"
      },
      "weight_compact": {
        "type": "string",
        "pattern": "^\\d+\\s?kg\\n\\(\\d+\\s?lbs\\)$",
        "example": "00 kg\n(00 lbs)",
        "notes": "Compact two-line format on small labels"
      },
      "dimensions_metric": {
        "type": "string",
        "pattern": "^\\d{1,4}x\\d{1,4}x?\\d{0,4}\\s?cm$",
        "example": "000x000x000 cm"
      },
      "dimensions_imperial": {
        "type": "string",
        "pattern": "^\\(\\d+\\s\\d+/\\d+x.*\"\\)$",
        "example": "(00 0/0x00 0/0x 00 0/0\")"
      },
      "copy_count_inline": {
        "type": "string",
        "pattern": "^1\\(\\d+\\)$",
        "example": "1(3)",
        "notes": "Copy n of total, printed on label face"
      },
      "copy_count_strip": {
        "type": "string",
        "pattern": "^\\d{1,2}$",
        "notes": "Single digit on right-edge strip"
      },
      "date_stamp_yyww": {
        "type": "string",
        "pattern": "^\\d{4}$",
        "example": "2614",
        "notes": "YYWW year-week stamp"
      },
      "date_alpha_code": {
        "type": "string",
        "pattern": "^[A-Z]{4}$",
        "example": "ABCD",
        "notes": "4-letter plant/batch code"
      },
      "date_numeric_prefix": {
        "type": "string",
        "pattern": "^\\d{3,4}$",
        "example": "1234"
      },
      "quantity_multiplier": {
        "type": "string",
        "pattern": "^[xX]\\s?\\d{1,3}$",
        "example": "x 123",
        "notes": "Multi-pack quantity"
      },
      "colour_dot": {
        "type": "object",
        "size_mm": "8x8",
        "notes": "Physical colour swatch dot printed on label"
      },
      "compliance_marks": {
        "type": "array",
        "allowed_values": [
          "CE",
          "TSCA ULEF",
          "CARB",
          "RoHS",
          "EPEAT"
        ]
      },
      "tsca_text": {
        "type": "string",
        "allowed_values": [
          "US EPA TSCA title VI compliant ULEF",
          "Conforme au US EPA TSCA titre VI TFEF"
        ]
      },
      "patents_url": {
        "type": "string",
        "allowed_values": [
          "www.IKEA.com/patents",
          "IKEA.com/patents"
        ]
      },
      "wash_symbols": {
        "type": "array",
        "notes": "ISO 3758 care symbols; count varies by product"
      },
      "legal_symbols": {
        "type": "array",
        "notes": "Market-specific legal icons"
      },
      "ca_code": {
        "type": "string",
        "pattern": "^CA\\s?0?5404$",
        "example": "CA 05404",
        "notes": "Canadian compliance code"
      },
      "nif_code": {
        "type": "string",
        "pattern": "^NIF\\sN[0-9A-Z]+$",
        "example": "NIF N03918B57J",
        "notes": "Spanish NIF code"
      },
      "ma_ice_code": {
        "type": "string",
        "pattern": "^MA-ICE\\s\\d+$",
        "example": "MA-ICE 001524613000018"
      },
      "gb_import_text": {
        "type": "string",
        "allowed_values": [
          "Imported to GB by: IKEA Ltd., 100 Avebury Blvd, Milton Keynes, UK, MK9 1FH"
        ]
      },
      "design_credit": {
        "type": "string",
        "allowed_values": [
          "Design: IKEA of Sweden"
        ]
      },
      "ikea_websites": {
        "type": "string",
        "example": "IKEA.com"
      },
      "product_image": {
        "type": "boolean",
        "notes": "Main product photo; present on 1C70-IDDDM and large labels"
      },
      "scientific_name": {
        "type": "string",
        "notes": "Plant scientific name; present on 1CIR40-IDFDM"
      },
      "care_symbols_plants": {
        "type": "array",
        "notes": "Care icons for plants (water, sun, etc.)"
      },
      "korean_text": {
        "type": "boolean",
        "notes": "Korean language text block; present on candle labels"
      }
    }
  },
  "naming_convention": {
    "copies": "Leading digit (1=single, 2=double row)",
    "shape": "R=Rectangular, C=Card/Landscape, CIR=Circular, L=Long Narrow, B=Booklet",
    "size": "Nominal height in mm (or diameter for circular)",
    "template": {
      "IDA": "Identity A — base: logo, name, article, DM, address",
      "IDB": "Identity B — IDA + compliance symbol zone",
      "IDC": "Identity C — compact/reduced fields",
      "IDD": "Identity D — IDA + product image",
      "IDE": "Identity E — textiles: wash symbols, legal symbols",
      "IDF": "Identity F — plants/flowers: scientific name, care icons",
      "IDG": "Identity G — Purchase Order (PO) variant",
      "PRA": "Product Reference A — small label, minimal fields",
      "PRB": "Product Reference B — small label, micro DM",
      "MIA": "Multi-Item A — multiple articles, gross+net weight",
      "MIB": "Multi-Item B — multiple articles, table rows",
      "CAA": "Canada A — CA code, NIF code, wash symbols",
      "IDID": "Candle label"
    },
    "suffix": "DM = DataMatrix present; no suffix = no DM"
  },
