{
  "label_type_id": "1C50-CAA",
  "label_type_name": "Card 50mm – Canada A",
  "source_pages": [
    29
  ],
  "description": "Canada market label. Includes CA registration code (CA 05404) and NIF. Wash/legal symbols. ITF 30% magnification.",
  "physical_dimensions_mm": {
    "width": 50,
    "height": "variable"
  },
  "shape": "card_portrait",
  "copy_count_default": 1,
  "datamatrix": {
    "symbol_size": "26x26",
    "x_dimension_options_mm": [
      0.4
    ],
    "specs": {
      "symbol_rows": 26,
      "symbol_cols": 26,
      "x_dim_mm": 0.4,
      "physical_mm": "10.4x10.4",
      "physical_incl_qz_mm": "11.2x11.2"
    },
    "gs1_ais_present": [
      "AI_240",
      "AI_13"
    ],
    "encoding": "GS1"
  },
  "itf_barcode": {
    "magnification_pct": 30,
    "x_dim_mm": 0.305,
    "ratio": 2.5,
    "module_width": 2,
    "barcode_height_mm": 10,
    "barcode_length_mm": 36.7,
    "total_length_incl_qz_mm": 42.8,
    "quiet_zone": "10 x-dim each side (2x3.1mm)"
  },
  "required_fields": [
    "product_name",
    "article_number",
    "internal_item_number",
    "origin_text",
    "supplier_name",
    "supplier_address",
    "copyright_notice",
    "plant_identifier",
    "human_readable_date",
    "ca_code",
    "nif_code",
    "wash_symbols",
    "copy_count_inline"
  ],
  "optional_fields": [
    "ikea_com_url",
    "compliance_marks",
    "legal_symbols"
  ],
  "field_patterns": {
    "product_name": {
      "type": "string",
      "pattern": "^[A-ZÅÄÖ][A-ZÅÄÖ0-9 /\\-]{0,39}$",
      "notes": "ALL-CAPS, max 40 chars"
    },
    "article_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "example": "803.812.94"
    },
    "internal_item_number": {
      "type": "string",
      "pattern": "^\\d{5}$",
      "example": "12345",
      "notes": "5-digit number printed near barcode"
    },
    "origin_text": {
      "type": "string",
      "pattern": "^(Made in|Assembled in)\\s.+$",
      "example": "Made in People's Republic of China"
    },
    "supplier_name": {
      "type": "string",
      "allowed_values": [
        "IKEA of Sweden AB"
      ]
    },
    "supplier_address": {
      "type": "string",
      "pattern": "^SE\\s[–-]\\s34381\\s[ÄA]lmhult$",
      "allowed_values": [
        "SE – 34381 Älmhult"
      ]
    },
    "copyright_notice": {
      "type": "string",
      "pattern": "^©\\s+Inter\\s+IKEA\\s+Systems\\s+B\\.V\\.\\s+\\d{4}$",
      "example": "© Inter IKEA Systems B.V. 2022"
    },
    "plant_identifier": {
      "type": "string",
      "pattern": "^PI-\\d{6,9}-\\d{1,3}$",
      "example": "PI-123456789-123"
    },
    "human_readable_date": {
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{2}$",
      "example": "26-04-02",
      "notes": "YY-MM-DD printed next to (YY-MM-DD) label"
    },
    "ca_code": {
      "type": "string",
      "pattern": "^CA\\s?0?5404$",
      "example": "CA 05404",
      "notes": "Canadian compliance code"
    },
    "nif_code": {
      "type": "string",
      "pattern": "^NIF\\sN[0-9A-Z]+$",
      "example": "NIF N03918B57J",
      "notes": "Spanish NIF code"
    },
    "copy_count_inline": {
      "type": "string",
      "pattern": "^1\\(\\d+\\)$",
      "example": "1(3)",
      "notes": "Copy n of total, printed on label face"
    }
  },
  "validation_rules": [
    {
      "rule_id": "1C50CA-001",
      "field": "ca_code",
      "check": "present",
      "severity": "error"
    },
    {
      "rule_id": "1C50CA-002",
      "field": "nif_code",
      "check": "present",
      "severity": "error"
    },
    {
      "rule_id": "1C50CA-003",
      "field": "ca_code",
      "check": "regex_match",
      "pattern": "^CA\\s?0?5404$",
      "severity": "error"
    }
  ],
  "market": "Canada"
}