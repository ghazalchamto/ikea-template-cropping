  "ean13_barcode": null,
  "required_fields": [
    "ikea_logo",
    "product_name",
    "article_number",
    "internal_item_number",
    "origin_text",
    "supplier_name",
    "supplier_address",
    "copyright_notice",
    "plant_identifier",
    "human_readable_date",
    "custom_identifier",
    "date_alpha_code",
    "date_stamp_yyww",
    "date_numeric_prefix",
    "dimensions_metric",
    "dimensions_imperial",
    "weight_compact",
    "copy_count_inline"
  ],
  "optional_fields": [
    "ikea_com_url",
    "compliance_marks",
    "legal_symbols",
    "tsca_text",
    "patents_url",
    "colour_dot",
    "quantity_multiplier"
  ],
  "idb_additional_fields": [
    "compliance_marks",
    "legal_symbols"
  ],
  "field_patterns": {
    "product_name": {
      "type": "string",
      "pattern": "^[A-ZÅÄÖ][A-ZÅÄÖ0-9 /\\-]{0,39}$",
      "notes": "ALL-CAPS, max 40 chars"
    },
    "article_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "example": "803.812.94"
    },
    "internal_item_number": {
      "type": "string",
      "pattern": "^\\d{5}$",
      "example": "12345",
      "notes": "5-digit number printed near barcode"
    },
    "origin_text": {
      "type": "string",
      "pattern": "^(Made in|Assembled in)\\s.+$",
      "example": "Made in People's Republic of China"
    },
    "plant_identifier": {
      "type": "string",
      "pattern": "^PI-\\d{6,9}-\\d{1,3}$",
      "example": "PI-123456789-123"
    },
    "supplier_name": {
      "type": "string",
      "allowed_values": [
        "IKEA of Sweden AB"
      ]
    },
    "supplier_address": {
      "type": "string",
      "pattern": "^SE\\s[–-]\\s34381\\s[ÄA]lmhult$",
      "allowed_values": [
        "SE – 34381 Älmhult"
      ]
    },
    "copyright_notice": {
      "type": "string",
      "pattern": "^©\\s+Inter\\s+IKEA\\s+Systems\\s+B\\.V\\.\\s+\\d{4}$",
      "example": "© Inter IKEA Systems B.V. 2022"
    },
    "custom_identifier": {
      "type": "string",
      "pattern": "^[A-Z]{4}-\\d{4}-\\d{3,4}$",
      "example": "ABCD-YYWW-1234",
      "notes": "ALPHA-YYWW-NUM; date section changes weekly"
    },
    "human_readable_date": {
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{2}$",
      "example": "26-04-02",
      "notes": "YY-MM-DD printed next to (YY-MM-DD) label"
    },
    "dimensions_metric": {
      "type": "string",
      "pattern": "^\\d{1,4}x\\d{1,4}x?\\d{0,4}\\s?cm$",
      "example": "000x000x000 cm"
    },
    "dimensions_imperial": {
      "type": "string",
      "pattern": "^\\(\\d+\\s\\d+/\\d+x.*\"\\)$",
      "example": "(00 0/0x00 0/0x 00 0/0\")"
    },
    "weight_compact": {
      "type": "string",
      "pattern": "^\\d+\\s?kg\\n\\(\\d+\\s?lbs\\)$",
      "example": "00 kg\n(00 lbs)",
      "notes": "Compact two-line format on small labels"
    },
    "copy_count_inline": {
      "type": "string",
      "pattern": "^1\\(\\d+\\)$",
      "example": "1(3)",
      "notes": "Copy n of total, printed on label face"
    }
  },
  "layout_zones": {
    "left_identity": "IKEA logo, product name, dimensions (metric+imperial), weight, article number",
    "center_barcode": "ITF-14 barcode + human-readable article number below",
    "center_datamatrix": "DataMatrix symbol + AI field text (AI_240, AI_11, date, PI)",
    "center_address": "Origin text, supplier name, address, copyright",
    "right_compliance": "Compliance symbols (IDB only)",
    "right_date": "Custom ID: ABCD-YYWW-1234 (and sub-fields)",
    "right_copy": "Copy count digit (rotated 90°)"
  },
  "validation_rules": [
    {
      "rule_id": "1R35-001",
      "field": "article_number",
      "check": "regex_match",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{2}$",
      "severity": "error"
    },
    {
      "rule_id": "1R35-002",
      "field": "internal_item_number",
      "check": "regex_match",
      "pattern": "^\\d{5}$",
      "severity": "error"
    },
    {
      "rule_id": "1R35-003",
      "field": "custom_identifier",
      "check": "regex_match",
      "pattern": "^[A-Z]{4}-\\d{4}-\\d{3,4}$",
      "severity": "error"
    },
    {
      "rule_id": "1R35-004",
      "field": "plant_identifier",
      "check": "regex_match",
      "pattern": "^PI-\\d{6,9}-\\d{1,3}$",
      "severity": "error"
    },
    {
      "rule_id": "1R35-005",
      "field": "supplier_address",
      "check": "exact_match",
      "value": "SE – 34381 Älmhult",
      "severity": "error"
    },
    {
      "rule_id": "1R35-006",
      "field": "datamatrix",
      "check": "ai_field_present",
      "ai": "240",
      "severity": "error"
    },
    {
      "rule_id": "1R35-007",
      "field": "datamatrix",
      "check": "ai_field_present",
      "ai": "11",
      "severity": "error"
    },
    {
      "rule_id": "1R35-008",
      "field": "dimensions_metric",
      "check": "regex_match",
      "pattern": "^\\d{1,4}x\\d{1,4}(x\\d{1,4})?\\s?cm$",
      "severity": "warning"
    },
    {
      "rule_id": "1R35-009",
      "field": "weight_compact",
      "check": "present",
      "severity": "warning"
    },
    {
      "rule_id": "1R35-010",
      "field": "copy_count_inline",
      "check": "regex_match",
      "pattern": "^1\\(\\d+\\)$",
      "severity": "warning"
    },
    {
      "rule_id": "1R35-011",
      "field": "itf_barcode_height",
      "check": "range_mm",
      "min": 10,
      "max": 15,
      "severity": "error"
    }
  ]
}